body {
    background-color: #f9f9f9;
    color: #333;
    font-family: Arial, sans-serif;
    text-align: center;
    padding: 30px;
}

.profile-pic {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    object-fit: cover;
}

.social-icons a {
    margin: 0 10px;
    display: inline-block;
}

.social-icons img {
    width: 40px;
    height: 40px;
    border-radius: 50%;
}

table {
    margin: 20px auto;
    border-collapse: collapse;
}

table, th, td {
    border: 1px solid #333;
    padding: 8px 12px;
}

.date-time {
    margin-top: 20px;
    font-size: 14px;
    color: #555;
}
